[application]
name=qmlProductManager
organizationName=ECJTU
organizationDomain=ecjtu.local
controlsStyle=Basic
graphicsApi=OpenGL
icon=:/images/favicon.ico
qmlEntry=qrc:/qml/Login&Register/Enter.qml

[userDatabase]
driver=QMYSQL
host=127.0.0.1
port=3306
name=user_management
username=root
password=请填写用户数据库密码

[businessDatabase]
driver=QMYSQL
host=127.0.0.1
port=3306
name=ecjtu_market
username=root
password=请填写业务数据库密码

[ai]
apiKey=请填写DeepSeek密钥
baseUrl=https://api.deepseek.com/chat/completions
model=deepseek-chat
stream=false
systemPrompt=你是产品进销存管理系统的小助手，只回答库存、入库、出库、收支记录和数据分析相关问题。非相关问题请礼貌说明能力范围。
